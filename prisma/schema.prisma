generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum WorkPackageType {
  TASK
  MILESTONE
  RISK
  PHASE
}

enum Priority {
  P0
  P1
  P2
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum Difficulty {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  ARCHIVED
}

enum PlatformRole {
  ADMIN
  PROJECT_MANAGER
  TEAM_LEAD
  PARTICIPANT
}

enum VerificationStatus {
  NOT_REQUIRED
  PENDING
  SELF_REPORTED_DONE
  VERIFIED
  REJECTED
}

enum WorkPackageOrigin {
  SELF
  AI_SELF
  MANAGER
  IM_IMPORT
}

enum WorkPackageCommentType {
  COMMENT
  DECISION
  BLOCKER
  EVIDENCE
}

enum WorkPackageCommentSource {
  PLATFORM
  FEISHU
  WECOM_BOT
  DINGTALK
  SLACK
  EMAIL
  GENERIC
}

enum WorkPackageApprovalStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

enum NotificationChannelType {
  FEISHU
  WECOM_BOT
  DINGTALK
  SLACK
  EMAIL
  GENERIC
}

enum NotificationDeliveryStatus {
  PREVIEW
  SENT
  SKIPPED
  FAILED
}

enum NotificationActivityType {
  COMMENT
  DECISION
  BLOCKER
  EVIDENCE
  APPROVAL
  PROGRESS
}

enum NotificationDecisionStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum AgentBreakdownDraftStatus {
  PENDING
  CONFIRMED
  DISCARDED
}

model Person {
  id              String                @id @default(cuid())
  name            String
  role            String
  capacity        Int
  skills          String                @default("[]")
  employeeNo      String?
  jobTitle        String?
  departmentCode  String?
  departmentName  String?
  externalId      String?               @unique
  workPackages    WorkPackage[]         @relation("AssignedWorkPackages")
  workPackageAssignments WorkPackageAssignment[]
  users           User[]
  comments        WorkPackageComment[]
  approvals       WorkPackageApproval[]
  teamMemberships TeamMembership[]
  externalPerson  ExternalPerson?
  sentNotificationMessages     NotificationMessage[] @relation("SentNotificationMessages")
  receivedNotificationMessages NotificationMessage[] @relation("ReceivedNotificationMessages")
}

model ExternalDepartment {
  id             String              @id @default(cuid())
  externalId     String              @unique
  name           String
  parentId       String?
  code           String?
  leaderId       String?
  leaderName     String?
  memberCount    Int                 @default(0)
  rawJson        String              @default("{}")
  syncedAt       DateTime            @default(now())
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  parent         ExternalDepartment? @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children       ExternalDepartment[] @relation("DepartmentHierarchy")
  persons        ExternalPerson[]

  @@index([parentId])
  @@index([externalId])
}

model ExternalPerson {
  id              String              @id @default(cuid())
  externalId      String              @unique
  name            String
  email           String?
  phone           String?
  employeeNo      String?
  jobTitle        String?
  departmentCode  String?
  departmentName  String?
  departmentId    String?
  isLeader        Boolean             @default(false)
  status          String              @default("active")
  avatarUrl       String?
  rawJson         String              @default("{}")
  syncedAt        DateTime            @default(now())
  personId        String?             @unique
  department      ExternalDepartment? @relation(fields: [departmentId], references: [id])
  person          Person?             @relation(fields: [personId], references: [id])

  @@index([departmentId])
  @@index([personId])
  @@index([externalId])
}

model ExternalSyncRun {
  id            String   @id @default(cuid())
  triggerType   String
  status        String
  deptsAdded    Int      @default(0)
  deptsUpdated  Int      @default(0)
  personsAdded  Int      @default(0)
  personsUpdated Int     @default(0)
  errorMessage  String?
  startedAt     DateTime @default(now())
  finishedAt    DateTime?

  @@index([startedAt])
}

model Team {
  id             String           @id @default(cuid())
  name           String
  description    String?
  leadId         String?
  manualOverride Boolean          @default(false)
  externalId     String?          @unique
  syncedAt       DateTime?
  memberships    TeamMembership[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([externalId])
}

model TeamMembership {
  id       String @id @default(cuid())
  teamId   String
  personId String
  team     Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([teamId, personId])
  @@index([teamId])
  @@index([personId])
}

model Project {
  id                   String                @id @default(cuid())
  identifier           String                @unique
  name                 String
  description          String?
  createdByUserId      String?
  parentId             String?
  parent               Project?              @relation("ProjectHierarchy", fields: [parentId], references: [id])
  children             Project[]             @relation("ProjectHierarchy")
  status               ProjectStatus         @default(ACTIVE)
  health               RiskLevel             @default(MEDIUM)
  initialDifficulty    Difficulty            @default(MEDIUM)
  difficultyOverride   Difficulty?
  progress             Int                   @default(0)
  startDate            DateTime?
  endDate              DateTime?
  enabledModules       String                @default("[]")
  workPackages         WorkPackage[]
  memberships          ProjectMembership[]
  stewardMessages      StewardMessage[]
  notificationRules    NotificationRule[]
  notificationMessages NotificationMessage[]
  agentBreakdownDrafts AgentBreakdownDraft[]
  qualitySnapshots     ProjectQualitySnapshot[]
  qualityMetrics       ProjectQualityMetric[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([parentId])
  @@index([createdByUserId])
}

model User {
  id                   String                @id @default(cuid())
  name                 String
  role                 PlatformRole
  roles                String                @default("[]")
  personId             String
  person               Person                @relation(fields: [personId], references: [id])
  memberships          ProjectMembership[]
  agentBreakdownDrafts AgentBreakdownDraft[]
  agentApiKeys         AgentApiKey[]
  agentInvocations     AgentToolInvocation[] @relation("CallerUserInvocations")
  createdWorkPackages  WorkPackage[]         @relation("CreatedWorkPackages")
  notificationMessages  NotificationMessage[] @relation("UserNotificationMessages")
  decidedNotifications  NotificationMessage[] @relation("DecidedNotificationMessages")
  createdAt            DateTime              @default(now())
}

model ProjectMembership {
  id        String  @id @default(cuid())
  userId    String
  projectId String
  isLead    Boolean @default(false)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

model WorkPackage {
  id               Int                   @id @default(autoincrement())
  projectId        String                @default("personProject")
  type             WorkPackageType       @default(TASK)
  subject          String
  description      String                @default("")
  status           String                @default("todo")
  priority         Priority              @default(P1)
  difficulty       Difficulty            @default(MEDIUM)
  origin           WorkPackageOrigin     @default(MANAGER)
  createdByUserId  String
  assigneeId       String?
  parentId         Int?
  parent           WorkPackage?          @relation("WorkPackageHierarchy", fields: [parentId], references: [id])
  children         WorkPackage[]         @relation("WorkPackageHierarchy")
  startDate        DateTime?
  dueDate          DateTime?
  estimateHours    Int?
  percentComplete  Int                   @default(0)
  lastProgressNote String                @default("")
  blockedReason    String?
  blockedStartedAt DateTime?
  blockedResolvedAt DateTime?
  delayReason      String?
  delayDays        Int                   @default(0)
  delayStartedAt   DateTime?
  delayResolvedAt  DateTime?
  progressUpdatedByUserId String?
  completedAt      DateTime?
  dependencies     String                @default("[]")
  requiredSkills   String                @default("[]")
  isOnCriticalPath Boolean               @default(false)
  riskLevel        RiskLevel?
  riskImpact       String?
  riskMitigation   String?
  project          Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy        User                  @relation("CreatedWorkPackages", fields: [createdByUserId], references: [id])
  assignee         Person?               @relation("AssignedWorkPackages", fields: [assigneeId], references: [id])
  comments         WorkPackageComment[]
  approvals        WorkPackageApproval[]
  notificationMessages NotificationMessage[]
  progressEvents   WorkPackageProgressEvent[]
  impactSources    WorkPackageImpactEvent[] @relation("ImpactSource")
  impactTargets    WorkPackageImpactEvent[] @relation("ImpactTarget")
  verificationStatus      VerificationStatus @default(NOT_REQUIRED)
  requiresVerification   Boolean            @default(false)
  verifiedByUserId       String?
  verifiedAt             DateTime?
  rejectedReason         String?
  requirements           WorkPackageRequirement[]
  assignments            WorkPackageAssignment[]
  attachments            WorkPackageAttachment[]
  createdAt              DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([projectId, type])
  @@index([projectId, status])
  @@index([createdByUserId])
  @@index([assigneeId])
  @@index([parentId])
}

model WorkPackageRequirement {
  id            String      @id @default(cuid())
  workPackageId Int
  content       String
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  workPackage   WorkPackage @relation(fields: [workPackageId], references: [id], onDelete: Cascade)

  @@index([workPackageId])
  @@index([workPackageId, sortOrder])
}

model WorkPackageAssignment {
  id             String      @id @default(cuid())
  workPackageId  Int
  personId       String
  role           String      @default("执行成员")
  responsibility String      @default("")
  sortOrder      Int         @default(0)
  createdAt      DateTime    @default(now())
  workPackage    WorkPackage @relation(fields: [workPackageId], references: [id], onDelete: Cascade)
  person         Person      @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([workPackageId, personId])
  @@index([workPackageId])
  @@index([personId])
  @@index([workPackageId, sortOrder])
}

model WorkPackageAttachment {
  id            String      @id @default(cuid())
  workPackageId Int
  fileName      String
  contentType   String
  size          Int
  dataUrl       String
  createdAt     DateTime    @default(now())
  workPackage   WorkPackage @relation(fields: [workPackageId], references: [id], onDelete: Cascade)

  @@index([workPackageId])
  @@index([workPackageId, createdAt])
}

model WorkPackageComment {
  id                String                   @id @default(cuid())
  workPackageId     Int
  authorPersonId    String
  body              String
  type              WorkPackageCommentType
  mentionsPersonIds String                   @default("[]")
  source            WorkPackageCommentSource @default(PLATFORM)
  sourceChannelId   String?
  externalMessageId String?
  externalThreadId  String?
  authorDisplayName String?
  workPackage       WorkPackage              @relation(fields: [workPackageId], references: [id], onDelete: Cascade)
  author            Person                   @relation(fields: [authorPersonId], references: [id])
  notificationMessages NotificationMessage[]
  createdAt         DateTime                 @default(now())

  @@unique([source, externalMessageId])
  @@index([workPackageId, createdAt])
}

model WorkPackageApproval {
  id               String                    @id @default(cuid())
  workPackageId    Int
  reviewerPersonId String
  status           WorkPackageApprovalStatus
  comment          String
  workPackage      WorkPackage               @relation(fields: [workPackageId], references: [id], onDelete: Cascade)
  reviewer         Person                    @relation(fields: [reviewerPersonId], references: [id])
  notificationMessages NotificationMessage[]
  createdAt        DateTime                  @default(now())

  @@index([workPackageId, createdAt])
}

model WorkPackageProgressEvent {
  id            String                       @id @default(cuid())
  workPackageId Int
  projectId     String?
  phaseRef      String?
  nodeRef       String?
  personId      String?
  userId        String?
  eventType     WorkPackageProgressEventType
  reason        String?
  previousJson  String                       @default("{}")
  nextJson      String                       @default("{}")
  occurredAt    DateTime                     @default(now())
  workPackage   WorkPackage                  @relation(fields: [workPackageId], references: [id], onDelete: Cascade)

  @@index([workPackageId, occurredAt])
  @@index([projectId, occurredAt])
  @@index([personId, eventType])
  @@index([eventType, occurredAt])
}

model WorkPackageImpactEvent {
  id                    String      @id @default(cuid())
  projectId             String?
  sourceWorkPackageId   Int
  impactedWorkPackageId Int
  dependencyPathJson    String      @default("[]")
  delayDays             Int         @default(0)
  reason                String?
  resolvedAt            DateTime?
  createdAt             DateTime    @default(now())
  sourceWorkPackage     WorkPackage @relation("ImpactSource", fields: [sourceWorkPackageId], references: [id], onDelete: Cascade)
  impactedWorkPackage   WorkPackage @relation("ImpactTarget", fields: [impactedWorkPackageId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([sourceWorkPackageId])
  @@index([impactedWorkPackageId])
  @@index([resolvedAt])
}

model StewardMessage {
  id        String    @id @default(cuid())
  projectId String?
  type      String
  title     String
  body      String
  level     RiskLevel
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
}

model NotificationChannel {
  id                String                    @id @default(cuid())
  name              String
  type              NotificationChannelType
  target            String
  enabled           Boolean                   @default(true)
  audienceRoles     String                    @default("[]")
  audiencePersonIds String                    @default("[]")
  secret            String?
  note              String?
  rules             NotificationRuleChannel[]
  deliveries        NotificationDelivery[]
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
}

model NotificationRule {
  id            String                    @id @default(cuid())
  projectId     String?
  name          String
  eventTypes    String                    @default("[]")
  minLevel      RiskLevel
  audienceRoles String                    @default("[]")
  project       Project?                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  channels      NotificationRuleChannel[]
  deliveries    NotificationDelivery[]
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
}

model NotificationRuleChannel {
  ruleId    String
  channelId String
  rule      NotificationRule    @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  channel   NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([ruleId, channelId])
}

model NotificationDelivery {
  id             String                     @id @default(cuid())
  channelId      String
  ruleId         String
  notificationId String
  status         NotificationDeliveryStatus
  preview        String
  payloadJson    String                     @default("{}")
  audienceRoles  String                     @default("[]")
  channel        NotificationChannel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  rule           NotificationRule           @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  createdAt      DateTime                   @default(now())
}

model NotificationTemplate {
  id               String                   @id @default(cuid())
  activityType     NotificationActivityType @unique
  name             String
  titleTemplate    String
  bodyTemplate     String
  cardTemplateJson String                   @default("{}")
  enabled          Boolean                  @default(true)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
}

model NotificationMessage {
  id                String                     @id @default(cuid())
  projectId         String
  workPackageId     Int?
  commentId         String?
  approvalId        String?
  senderPersonId    String?
  recipientPersonId String
  recipientUserId   String?
  activityType      NotificationActivityType
  title             String
  body              String
  actionRequired    Boolean                    @default(false)
  decisionStatus    NotificationDecisionStatus @default(NONE)
  readAt            DateTime?
  decidedByUserId   String?
  decidedAt         DateTime?
  payloadJson       String                     @default("{}")
  createdAt         DateTime                   @default(now())
  project           Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workPackage       WorkPackage?               @relation(fields: [workPackageId], references: [id], onDelete: Cascade)
  comment           WorkPackageComment?        @relation(fields: [commentId], references: [id], onDelete: SetNull)
  approval          WorkPackageApproval?       @relation(fields: [approvalId], references: [id], onDelete: SetNull)
  senderPerson      Person?                    @relation("SentNotificationMessages", fields: [senderPersonId], references: [id], onDelete: SetNull)
  recipientPerson   Person                     @relation("ReceivedNotificationMessages", fields: [recipientPersonId], references: [id], onDelete: Cascade)
  recipientUser     User?                      @relation("UserNotificationMessages", fields: [recipientUserId], references: [id], onDelete: SetNull)
  decidedBy         User?                      @relation("DecidedNotificationMessages", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@index([recipientUserId, createdAt])
  @@index([recipientPersonId, createdAt])
  @@index([projectId, createdAt])
  @@index([workPackageId, createdAt])
  @@index([commentId])
  @@index([activityType, decisionStatus])
}

model PlatformFeatureFlag {
  key           String   @id
  siteEnabled   Boolean  @default(true)
  roleOverrides String   @default("{}")
  description   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PermissionOverride {
  id              String   @id @default(cuid())
  subjectType     String
  subjectId       String
  permissionKey   String
  effect          String
  scopeType       String   @default("global")
  scopeId         String   @default("__global__")
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([subjectType, subjectId, permissionKey, scopeType, scopeId])
  @@index([subjectType, subjectId])
  @@index([permissionKey])
  @@index([scopeType, scopeId])
}

model AgentApiKey {
  id             String                @id @default(cuid())
  name           String
  keyPrefix      String                @unique
  hashedKey      String
  allowedTools   String                @default("[]")
  allowedRoles   String                @default("[]")
  qpsLimit       Int                   @default(5)
  dailyLimit     Int                   @default(1000)
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdByUserId String
  createdBy      User                  @relation(fields: [createdByUserId], references: [id])
  invocations    AgentToolInvocation[]
  createdAt      DateTime              @default(now())
}

model AgentToolInvocation {
  id                 String       @id @default(cuid())
  toolName           String
  callerUserId       String?
  callerApiKeyId     String?
  source             String       @default("rest")
  inputJson          String       @default("{}")
  outputJson         String       @default("{}")
  status             String
  errorMessage       String?
  idempotencyKey     String?
  parentInvocationId String?
  durationMs         Int          @default(0)
  callerUser         User?        @relation("CallerUserInvocations", fields: [callerUserId], references: [id])
  callerApiKey       AgentApiKey? @relation(fields: [callerApiKeyId], references: [id])
  createdAt          DateTime     @default(now())

  @@index([toolName, createdAt])
  @@index([callerUserId, createdAt])
  @@index([callerApiKeyId, createdAt])
  @@unique([idempotencyKey, toolName])
}

model AgentBreakdownDraft {
  id              String                    @id @default(cuid())
  projectId       String?
  createdByUserId String
  prompt          String
  analysisJson    String
  status          AgentBreakdownDraftStatus @default(PENDING)
  project         Project?                  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy       User                      @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
}

enum ScheduleScenarioStatus {
  DRAFT
  PROPOSED
  APPLIED
  DISCARDED
}

enum QualitySnapshotSource {
  BASELINE
  DRAFT
  APPLIED
}

enum WorkPackageProgressEventType {
  PROGRESS_UPDATED
  BLOCKED
  BLOCKED_RESOLVED
  DELAYED
  DELAY_RESOLVED
  RISK_CHANGED
  COMPLETED
}

enum ProjectQualitySnapshotTrigger {
  MANUAL
  TASK_PROGRESS_UPDATED
  NODE_COMPLETED
  MILESTONE_COMPLETED
  BLOCKED_CHANGED
  BLOCKED_RESOLVED
  DELAY_CHANGED
  DELAY_RESOLVED
  IMPACT_PROPAGATED
  PROJECT_COMPLETED
}

model ScheduleBaseline {
  id              String             @id @default(cuid())
  projectId       String
  version         Int
  snapshotJson    String
  appliedByUserId String?
  appliedAt       DateTime           @default(now())
  scenarios       ScheduleScenario[]
  createdAt       DateTime           @default(now())

  @@unique([projectId, version])
  @@index([projectId, appliedAt])
}

model ScheduleScenario {
  id              String                 @id @default(cuid())
  projectId       String
  baselineId      String?
  name            String
  status          ScheduleScenarioStatus @default(DRAFT)
  draftJson       String
  agentSummary    String?
  createdByUserId String
  appliedAt       DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  baseline        ScheduleBaseline?      @relation(fields: [baselineId], references: [id], onDelete: SetNull)
  changes         ScheduleChange[]

  @@index([projectId, status])
  @@index([projectId, updatedAt])
}

model ScheduleChange {
  id          String           @id @default(cuid())
  scenarioId  String
  changeType  String
  targetRef   String
  payloadJson String           @default("{}")
  createdAt   DateTime         @default(now())
  scenario    ScheduleScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@index([scenarioId, createdAt])
}

model ProjectQualitySnapshot {
  id                String                 @id @default(cuid())
  projectId         String
  source            QualitySnapshotSource
  triggerType       ProjectQualitySnapshotTrigger @default(MANUAL)
  scenarioId        String?
  baselineId        String?
  projectProgress   Int
  projectDifficulty Difficulty
  startDate         DateTime?
  endDate           DateTime?
  phaseCount        Int
  nodeCount         Int
  taskItemCount     Int
  metricJson        String                 @default("{}")
  aiContextJson     String                 @default("{}")
  createdByUserId   String?
  createdAt         DateTime               @default(now())
  project           Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  metrics           ProjectQualityMetric[]

  @@index([projectId, createdAt])
  @@index([projectId, source, createdAt])
  @@index([scenarioId])
  @@index([baselineId])
}

model ProjectQualityMetric {
  id              String                 @id @default(cuid())
  snapshotId      String
  projectId       String
  entityType      String
  entityRef       String
  metricKey       String
  numericValue    Float?
  textValue       String?
  difficultyValue Difficulty?
  startDate       DateTime?
  endDate         DateTime?
  personId        String?
  teamRef         String?
  evidenceJson    String                 @default("{}")
  createdAt       DateTime               @default(now())
  snapshot        ProjectQualitySnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  project         Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([projectId, entityType, metricKey])
  @@index([personId, metricKey])
  @@index([teamRef, metricKey])
}
